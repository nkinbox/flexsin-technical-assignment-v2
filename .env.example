# ---------------------------------------------------------------------------
# Provider: "dev" runs the whole pipeline offline with deterministic stub
# embeddings and a template answer builder -- no GCP credentials required.
# Switch to "vertex" once Google Cloud is configured (see README section 8).
# ---------------------------------------------------------------------------
PROVIDER=dev

# --- Google Vertex AI (only required when PROVIDER=vertex) ---
GCP_PROJECT_ID=flexsin-rag
GCP_REGION=us-central1
GEN_MODEL=gemini-2.5-pro
EMBED_MODEL=gemini-embedding-001

# Only needed for the service-account key fallback. Leave blank when using
# Application Default Credentials (impersonation locally, attached service
# account on Compute Engine) -- which is the recommended path.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/key.json

# --- Weaviate ---
# Use "localhost" when running uvicorn on the host, "weaviate" inside compose
# (docker-compose.yml sets that automatically for the app container).
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# --- Caddy / deployment ---
# ":80"              -> plain HTTP, reach the VM by its external IP
# "rag.example.com"  -> automatic HTTPS via Let's Encrypt (DNS must point here,
#                       and TCP 80 + 443 must be open in the GCP firewall)
SITE_ADDRESS=:80

# --- Chunking ---
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_RATIO=0.15

# --- Retrieval ---
TOP_K=5
OVERFETCH=15
RELEVANCE_FLOOR=0.30
MAX_PARENTS=3
PARENT_CONTEXT_TOKENS=6000
HYBRID_ALPHA=0.5

# --- Storage ---
UPLOAD_DIR=./data/uploads
